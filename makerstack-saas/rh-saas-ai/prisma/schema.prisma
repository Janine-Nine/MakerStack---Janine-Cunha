generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Company {
  id              String   @id @default(uuid())
  name            String
  cnpj            String
  context         String?
  createdAt       DateTime @default(now())

  users           User[]
  jobs            Job[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String?
  companyId String
  createdAt DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id])
}

model Job {
  id          String   @id @default(uuid())
  title       String
  description String?
  companyId   String

  company     Company  @relation(fields: [companyId], references: [id])
  candidates  Candidate[]
  matches     MatchReport[]
}

model Candidate {
  id          String   @id @default(uuid())
  name        String
  email       String
  jobId       String

  disc        Json?
  enneagram   Json?
  mbti        Json?

  job         Job      @relation(fields: [jobId], references: [id])
  matches     MatchReport[]
}

model MatchReport {
  id          String   @id @default(uuid())
  jobId       String
  candidateId String
  score       Float
  report      Json

  job         Job      @relation(fields: [jobId], references: [id])
  candidate   Candidate @relation(fields: [candidateId], references: [id])
}



