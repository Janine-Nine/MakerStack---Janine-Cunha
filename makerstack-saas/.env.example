############################################
# 🗄️ DATABASE
############################################

DATABASE_URL="prisma+postgres://localhost:51213/?api_key=YOUR_API_KEY"

############################################
# 🔐 AUTHENTICATION (NextAuth)
############################################

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-generate-with-openssl"

# Application URL
NEXTAUTH_URL="http://localhost:3000"

############################################
# 🌐 API CONFIGURATION
############################################

# Backend API URL
NEXT_PUBLIC_API_URL="http://localhost:3333"

############################################
# 🔑 GOOGLE OAUTH
############################################

# Get from: https://console.cloud.google.com
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# 🤖 IA (OpenAI / Anthropic)
############################################

# OpenAI API Key (recomendado para MVP)
OPENAI_API_KEY="your-openai-api-key"

# Anthropic API Key (opcional)
ANTHROPIC_API_KEY=""


############################################
# ☁️ DEPLOY / CI-CD
############################################

# Token do Vercel (deploy automático)
VERCEL_TOKEN=""

# Token do Railway (deploy API)
RAILWAY_TOKEN=""


############################################
# 📊 MONITORAMENTO (OPCIONAL)
############################################

SENTRY_AUTH_TOKEN=""
SENTRY_DSN=""


############################################
# 📤 STORAGE (OPCIONAL)
############################################

STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""
STORAGE_REGION=""


############################################
# 📧 EMAIL (OPCIONAL)
############################################

RESEND_API_KEY=""
SENDGRID_API_KEY=""


############################################
# ⚙️ APP CONFIG
############################################

NODE_ENV="development"

APP_NAME="MakerStack RH AI"
APP_URL="http://localhost:3000"